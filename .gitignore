# ──────────────────────────────────────────────────────────────
# Ophir ERP — Next.js / TypeScript .gitignore
# ──────────────────────────────────────────────────────────────

# Dependencies
/node_modules
/.pnp
.pnp.js
.pnp.cjs
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js build output
/.next/
/out/
/build
/dist
next-env.d.ts

# Production / misc build artifacts
*.tsbuildinfo

# Testing / coverage
/coverage
/.nyc_output

# Environment variables (never commit secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
logs
*.log
_dev.log

# Caches
.eslintcache
.cache/
.turbo/
.vercel

# Editor / IDE
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
desktop.ini

# Certificates / keys
*.pem
*.key

# Local SRS extraction artifacts (regenerate with _extract_docx.py)
# Comment out the next two lines if you want them tracked in the repo.
# _SRS_extracted.md
# _extract_docx.py
branch_structure.json
temp_auto_push.bat
temp_interactive_push.bat
